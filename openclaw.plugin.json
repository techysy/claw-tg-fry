{
  "id": "claw-tg-fry",
  "description": "🍤 OpenClaw Telegram 通道插件——fry 流式卡片与打字机引擎（派发即建卡 · 动态节流调度 · 4096 智能分页 · 原生折叠与指标面板）",
  "channels": ["telegram"],
  "skills": [],
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
      "botToken": {
        "type": "string",
        "title": "Telegram Bot Token",
        "description": "从 @BotFather 获取的 Bot API Token"
      },
      "apiRoot": {
        "type": "string",
        "title": "API Root / Proxy Endpoint",
        "description": "自定义 Telegram API 根地址（支持本地反代，默认 https://api.telegram.org）"
      },
      "connectionMode": {
        "type": "string",
        "enum": ["polling", "webhook"],
        "title": "连接模式",
        "description": "长轮询 polling（推荐，无需公网 IP）或 webhook"
      },
      "throttleIntervalMs": {
        "type": "number",
        "title": "打字机节流周期 (ms)",
        "description": "流式卡片就地编辑节流刷新间隔，默认 900ms（防 429 限频）"
      },
      "instantPlaceholder": {
        "type": "boolean",
        "title": "派发即建卡",
        "description": "收到用户提问后 1 秒内回复占位卡「🍤 正在思考...」（默认 true）"
      },
      "footer": {
        "type": "object",
        "title": "Footer 显示项",
        "description": "卡片底部元信息项开关，默认全部关闭（与 hermes-fry-cards 同源语义）",
        "properties": {
          "status": {
            "type": "boolean",
            "default": false,
            "title": "状态",
            "description": "已完成 / 出错 / 已停止"
          },
          "elapsed": {
            "type": "boolean",
            "default": false,
            "title": "耗时",
            "description": "本轮耗时（如 1m 05s）"
          },
          "tokens": {
            "type": "boolean",
            "default": false,
            "title": "Token 消耗",
            "description": "↑ 输入 ↓ 输出"
          },
          "cache": {
            "type": "boolean",
            "default": false,
            "title": "缓存",
            "description": "缓存读写量与命中率"
          },
          "context": {
            "type": "boolean",
            "default": false,
            "title": "上下文",
            "description": "上下文占用/窗口"
          },
          "model": {
            "type": "boolean",
            "default": false,
            "title": "模型",
            "description": "本轮调度模型名"
          },
          "provider": {
            "type": "boolean",
            "default": false,
            "title": "供应商",
            "description": "模型供应商"
          }
        }
      },
      "panel": {
        "type": "object",
        "title": "指标面板",
        "properties": {
          "unifiedPanelMinDuration": {
            "type": "number",
            "default": 3,
            "title": "面板耗时门槛（秒）",
            "description": "指标面板显示的耗时门槛（秒）：耗时 ≥ 此值或有思考/工具调用时显示，0 = 每条必出（默认 3）"
          },
          "contextDisplayMode": {
            "type": "string",
            "enum": ["text", "bar", "text_bar"],
            "default": "text_bar",
            "title": "上下文展示模式",
            "description": "text = 纯文本；bar = 仅进度条；text_bar = 文本+进度条"
          },
          "expanded": {
            "type": "boolean",
            "default": false,
            "title": "默认展开",
            "description": "面板是否默认展开"
          },
          "truncateModelName": {
            "type": "boolean",
            "default": true,
            "title": "截断模型名",
            "description": "or/lc/LongCat-2.0 → ⇲LongCat-2.0（取最后一段）"
          },
          "modelAliasesEnabled": {
            "type": "boolean",
            "default": true,
            "title": "启用模型别名",
            "description": "是否应用 modelAliases / peakValley 别名"
          },
          "modelAliases": {
            "type": "object",
            "title": "模型别名配置",
            "description": "模型显示别名（支持时段人设对象 {name, timeAliases}）"
          },
          "peakValley": {
            "type": "array",
            "title": "峰谷价别名",
            "description": "按时段切换峰/谷名称",
            "items": {
              "type": "object",
              "properties": {
                "match": {
                  "type": "string",
                  "title": "匹配模型"
                },
                "peakName": {
                  "type": "string",
                  "title": "忙时名称"
                },
                "valleyName": {
                  "type": "string",
                  "title": "闲时名称"
                },
                "schedule": {
                  "type": "string",
                  "title": "时段规格",
                  "description": "deepseek / workday-918 / everyday-day / always-peak / custom"
                }
              }
            }
          },
          "fields": {
            "type": "array",
            "title": "显示字段（有序）",
            "description": "数组顺序即面板标题段显示顺序；未列出的段不显示。缺省 = 全部字段",
            "items": {
              "type": "string",
              "enum": [
                "model",
                "reasoning",
                "tools",
                "context",
                "cache",
                "output",
                "speed",
                "elapsed"
              ]
            }
          }
        }
      }
    }
  },
  "channelConfigs": {
    "telegram": {
      "schema": {
        "type": "object"
      }
    }
  }
}
