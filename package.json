{
  "name": "claw-tg-fry",
  "version": "1.0.0",
  "description": "🍤 claw-tg-fry — OpenClaw Telegram 通道插件（fry 流式卡片与节流打字机引擎 · 派发即建卡 · 4096 字符智能分页 · 原生折叠与指标面板）",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techysy/claw-tg-fry.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.49",
    "grammy": "^1.35.0",
    "undici": "^6.21.1",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "openclaw": "link:../claw-fry-cards/node_modules/openclaw",
    "tsdown": "^0.21.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.mjs"
    ]
  }
}
